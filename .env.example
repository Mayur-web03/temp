# SenaSetu AI — optional Supabase
# Leave both blank to use the built-in local demo dataset (recommended until the schema is applied).
# Paste your Supabase project URL and anon / publishable key to persist live tables.
# You can also paste the same keys in the Live feeds panel — no rebuild required.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

